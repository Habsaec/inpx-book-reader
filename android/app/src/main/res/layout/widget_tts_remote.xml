<?xml version="1.0" encoding="utf-8"?>
<!-- Read-aloud remote, square / tall cells: the cover fills the widget, controls on a bottom gradient. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_continue_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_cover_fill_placeholder" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_tts_scrim" />

    <ImageView
        android:id="@+id/widget_lib_scrim"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_top_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_lib_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="52dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_lib_logo"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:maxWidth="64dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_lib_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textColor="#ffffffff"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_tts_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_tts_label"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_tts_sleep_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_ic_sleep"
                android:visibility="gone" />

            <Chronometer
                android:id="@+id/widget_tts_sleep_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#ccffffff"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:hyphenationFrequency="none"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:text="@string/widget_continue_empty"
            android:textColor="#ffffffff"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textColor="#ccffffff"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_tts_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_round_btn_bg"
                android:contentDescription="@string/widget_tts_prev"
                android:padding="9dp"
                android:src="@drawable/widget_ic_skip_prev" />

            <ImageView
                android:id="@+id/widget_tts_play"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/widget_accent_btn_bg"
                android:contentDescription="@string/widget_tts_play"
                android:padding="13dp"
                android:src="@drawable/widget_ic_play" />

            <ImageView
                android:id="@+id/widget_tts_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_round_btn_bg"
                android:contentDescription="@string/widget_tts_next"
                android:padding="9dp"
                android:src="@drawable/widget_ic_skip_next" />

            <ImageView
                android:id="@+id/widget_tts_sleep"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/widget_round_btn_bg"
                android:contentDescription="@string/widget_tts_sleep"
                android:padding="10dp"
                android:src="@drawable/widget_ic_sleep" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_tts_stop"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/widget_dark_btn_bg"
        android:contentDescription="@string/widget_tts_stop"
        android:padding="9dp"
        android:src="@drawable/widget_ic_close"
        android:visibility="gone" />
</FrameLayout>
