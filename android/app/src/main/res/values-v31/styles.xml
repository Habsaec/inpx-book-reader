<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+: только цвет фона, без иконки в системном слоте -->
    <style name="AppTheme.NoActionBarLaunch.Light" parent="Theme.SplashScreen">
        <item name="android:background">@color/splash_background_light</item>
        <item name="android:windowBackground">@color/splash_background_light</item>
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Dark" parent="Theme.SplashScreen">
        <item name="android:background">@color/splash_background_dark</item>
        <item name="android:windowBackground">@color/splash_background_dark</item>
        <item name="windowSplashScreenBackground">@color/splash_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBarLaunch.Dark" />
</resources>
