<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Pre-API 31: explicit light/dark launch themes (picked in MainActivity) -->
    <style name="AppTheme.NoActionBarLaunch.Light" parent="AppTheme.NoActionBar">
        <item name="android:background">@color/splash_background_light</item>
        <item name="android:windowBackground">@color/splash_background_light</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Dark" parent="AppTheme.NoActionBar">
        <item name="android:background">@color/splash_background_dark</item>
        <item name="android:windowBackground">@color/splash_background_dark</item>
    </style>

    <!-- Manifest fallback; MainActivity overrides via setTheme() -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBarLaunch.Dark" />
</resources>
