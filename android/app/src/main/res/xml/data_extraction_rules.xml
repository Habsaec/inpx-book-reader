<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: fullBackupContent игнорируется. Без этих правил облако
     забирает SQLite библиотеки и ciphertext credentials. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
