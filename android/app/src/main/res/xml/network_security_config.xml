<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Домашний INPX-сервер обычно без HTTPS -->
    <!-- src="user": HTTPS с сертификатом домашнего CA (mkcert и т. п.), который
         пользователь сам установил в настройках Android. Проверка цепочки и имени
         сервера остаётся полной. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
