{
  "name": "inpx-book-reader",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:app": "node scripts/sync-foliate-assets.mjs && node scripts/verify-foliate-page-turn.mjs && node scripts/sync-shared-reader.mjs && node scripts/verify-position-sync.mjs && node scripts/verify-reader-position-shadow.mjs && node scripts/generate-reader-html.mjs && vite build",
    "brand:assets": "node scripts/generate-branding-assets.mjs",
    "sync:reader": "node scripts/generate-reader-html.mjs",
    "sync:shared": "node scripts/sync-foliate-assets.mjs && node scripts/sync-shared-reader.mjs && node scripts/verify-position-sync.mjs && node scripts/verify-reader-position-shadow.mjs && node scripts/generate-reader-html.mjs",
    "verify:api-parity": "node scripts/verify-api-parity.mjs",
    "build:android": "npm run build:app && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "verify:reader": "node scripts/verify-local-reader.mjs",
    "android:open": "npx cap open android",
    "android:sync": "npx cap sync android",
    "start": "node dist/server.cjs",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/android": "^7.6.7",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.7",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.10.6",
    "playwright-core": "^1.51.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
